UNBAN_DB_PATH=/var/lib/unban-scheduler/unban.db
UNBAN_RETRY_SECONDS=600
UNBAN_BATCH_LIMIT=300

# Block list published to the firewalls as an external dynamic list (served by a web server)
IP_BLOCK_LIST_PATH=/var/www/html/ip_list.txt

# Symantec / BlueCoat Edge SWG policy content
BLUECOAT_CONTENT_URL=https://proxy-mgmt.example.com:8082/api/policies/<policy-uuid>/content
BLUECOAT_TOKEN=your-api-token
BLUECOAT_STATE_PATH=/var/lib/unban-scheduler/bluecoat_domains.json
BLUECOAT_VERIFY_SSL=true

# Prisma Access (service account with URL category edit rights)
PRISMA_CLIENT_ID=your-service-account@123456789.iam.panserviceaccount.com
PRISMA_CLIENT_SECRET=your-client-secret
PRISMA_TSG_ID=123456789
PRISMA_CATEGORY_ID=your-url-category-uuid

# IBM QRadar SOAR (legacy unban flag + metrics)
SOAR_HOST=soar.example.com
SOAR_PORT=443
SOAR_ORG=Example Org
SOAR_API_KEY_ID=your-api-key-id
SOAR_API_KEY_SECRET=your-api-key-secret
SOAR_CAFILE=

# Error summary mail (one mail per run)
SMTP_HOST=smtp.example.com
SMTP_PORT=25
SMTP_STARTTLS=false
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=unban-scheduler@example.com
ALERT_MAIL_TO=soc-engineering@example.com
